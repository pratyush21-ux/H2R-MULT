flowchart LR
    A["A[15:0] (16 bits)"]
    Q["Q[15:0] (16 bits)"]

    subgraph MSB["Exact radix-4 MSB block (Q15 to Q6)"]
        direction LR
        R4E["Radix-4 Booth encoder<br/>5 groups: (Q7 Q6 Q5) ... (Q15 Q14 Q13)"]
        R4P["PP generators x5<br/>{0, ±M, ±2M}<br/>PP2 ... PP6"]
        R4A["Exact adder<br/>weights 2^(2j+6), j = 0...4"]
        R4S["Shift left by 6<br/>sign-extend 26 to 32"]
        R4E -- "digits d2...d6" --> R4P
        R4P -- "5 x 17 bits" --> R4A
        R4A -- "26 bits" --> R4S
    end

    LSB["Radix-8 LSB partial products<br/>PP0, PP1 omitted<br/>(no LSB encoder, PP generator or adder)"]
    P["P[31:0] (32 bits)"]

    Q -- "Q[15:6], 10 bits" --> R4E
    Q -. "Q5 (reference bit)" .-> R4E
    Q -. "Q[4:0] unused" .-> LSB
    A -- "16 bits" --> R4P
    R4S -- "32 bits" --> P

    classDef exact fill:#ffffff,stroke:#555,stroke-dasharray:5 3
    classDef omitted fill:#f3f3f3,stroke:#999,stroke-dasharray:3 3,color:#777
    class MSB exact
    class LSB omitted
